.PHONY : proxygen_h3datagram_client/fast

#=============================================================================
# Target rules for targets named libhttperf2

# Build rule for target.
libhttperf2: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 libhttperf2
.PHONY : libhttperf2

# fast build rule for target.
libhttperf2/fast:
	$(MAKE) $(MAKESILENT) -f httpclient/samples/httperf2/CMakeFiles/libhttperf2.dir/build.make httpclient/samples/httperf2/CMakeFiles/libhttperf2.dir/build
.PHONY : libhttperf2/fast

