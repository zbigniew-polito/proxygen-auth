	cd /home/zpo/dev/proxygen-auth/build-aarch64-rpi4b-linux-gnu && $(MAKE) $(MAKESILENT) -f httpserver/CMakeFiles/proxygen_static.dir/build.make httpserver/CMakeFiles/proxygen_static.dir/samples/static/StaticServer.cpp.s
.PHONY : samples/static/StaticServer.cpp.s

