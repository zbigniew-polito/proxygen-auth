--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -46,10 +46,11 @@
 # Check for quadmath support
 include(CheckCXXSourceCompiles)
 include(CheckCXXSymbolExists)
-check_cxx_source_compiles(\"
-#include <quadmath.h>
-int main() {
-  __float128 f = 0.0Q;
-  f = f;
-}
-\" BOOST_CHARCONV_QUADMATH_FOUND)
+
+# Hardcode quadmath support OFF for cross-compilation to avoid try_run issues
+# We remove the original check and hardcode the result variables
+set(BOOST_CHARCONV_QUADMATH_FOUND FALSE CACHE INTERNAL "Hardcoded quadmath support to OFF for cross-compilation")
+set(BOOST_CHARCONV_NO_QUADMATH TRUE CACHE INTERNAL "Hardcoded disable quadmath support for cross-compilation")
 
 if(BOOST_CHARCONV_QUADMATH_FOUND)
 message(STATUS "Boost.Charconv: quadmath support ON")
